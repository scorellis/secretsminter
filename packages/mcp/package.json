  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@secretsminter/core": "0.1.0",
    "zod": "^3.23.0"
  },
  "scripts": {
    "build": "tsc --build"
  }
}
